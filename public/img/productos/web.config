<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Keep the WebP mapping local to product photos on IIS. -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
